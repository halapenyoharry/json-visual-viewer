{
  "name": "json-visual-viewer",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "publisher": "halapenyoharry",
  "displayName": "JSON Visual Viewer",
  "description": "Visualize JSON as interactive tree, force graph, Cytoscape graph, 3D WebGL graph, or circle packing",
  "repository": {
    "type": "git",
    "url": "https://github.com/halapenyoharry/json-visual-viewer.git"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist-extension/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "json-visual-viewer.open",
        "title": "JSON Visual Viewer: Open"
      },
      {
        "command": "json-visual-viewer.viewCurrent",
        "title": "JSON Visual Viewer: View Current File"
      },
      {
        "command": "json-visual-viewer.browse",
        "title": "JSON Visual Viewer: Browse Workspace JSON…"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "json-visual-viewer.viewCurrent",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "json-visual-viewer.viewCurrent",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "json-visual-viewer.viewCurrent",
          "when": "resourceExtname == .json",
          "group": "navigation@99"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "json-visual-viewer.editor",
        "displayName": "JSON Visual Viewer",
        "selector": [
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.jsonc"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:webview": "vite build --config vite.webview.config.ts",
    "build:extension": "esbuild src-vscode/extension.ts --bundle --outfile=dist-extension/extension.cjs --external:vscode --platform=node --format=cjs",
    "build:vscode": "npm run build:webview && npm run build:extension",
    "package:vscode": "npm run build:vscode && vsce package"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.10.1",
    "@types/cytoscape": "^3.21.9",
    "@types/d3": "^7.4.3",
    "cytoscape": "^3.33.2",
    "cytoscape-fcose": "^2.2.0",
    "d3": "^7.9.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-3d": "^1.29.1",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
